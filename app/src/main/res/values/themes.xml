<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.App" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        
        <item name="android:statusBarColor">@color/card_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Launch theme for MainActivity: fixes the grey screen at app start -->
    <style name="Theme.App.Launch" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>