    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Main Chat Screen Layout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Bar Layout -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_alignParentTop="true"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/menuBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Siri AI"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- ChatGPT Style Single Container Bottom Input -->
            <LinearLayout
                android:id="@+id/bottomInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#000000"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_message_user"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Ask Siri AI..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/voiceBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_message_user"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/sendBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_message_user"
                        android:padding="8dp"
                        android:src="@drawable/ic_gemini_live" />
                </LinearLayout>
            </LinearLayout>

            <!-- Welcome Layout -->
            <LinearLayout
                android:id="@+id/welcomeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, I'm Siri AI"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="How can I help you today?"
                    android:textColor="#888888"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Chat Messages ScrollView -->
            <ScrollView
                android:id="@+id/chatScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/bottomInputLayout"
                android:layout_below="@id/topBar"
                android:fillViewport="true"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/chatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

        </RelativeLayout>

        <!-- Side Slide Menu (Navigation Drawer) -->
